# Configurações da API do Asaas
# Crie sua conta de testes em: https://sandbox.asaas.com
# Gere a chave de API em: Menu lateral > Configurações da Conta > Integrações > Chaves de API
ASAAS_API_KEY=$aact_sandbox_SEU_TOKEN_AQUI

# Ambiente: 'sandbox' para testes ou 'production' para cobranças reais
ASAAS_ENVIRONMENT=sandbox

# Token de autenticação do webhook Asaas (opcional, para validar requisições do webhook)
ASAAS_WEBHOOK_ACCESS_TOKEN=seu_token_webhook_secreto

# Telefone oficial de suporte / recepção da Academia Metamorfose (formato DDI + DDD + Número)
WHATSAPP_NUMBER=5522998449106

# Credenciais do Supabase (PostgreSQL Central para Concorrência Multi-Admin)
# Obtenha em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta

# Segurança do Painel Administrativo (/admin)
ADMIN_PASSWORD=metamorfose2026
ADMIN_JWT_SECRET=chave_secreta_jwt_para_assinatura_de_sessoes
